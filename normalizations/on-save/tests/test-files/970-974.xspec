<?xml version="1.0" encoding="utf-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:xs="http://www.w3.org/2001/XMLSchema"
               xmlns:marc="http://www.loc.gov/MARC21/slim"
               stylesheet="../../normalize-on-save.xsl">

  <x:scenario label="970-974">
    <x:scenario label="9700# bei barrierefrei aufbereiteten Ressourcen">
      <x:scenario label="9700#$$abarrierefrei aufbereitet, kein $$i">
        <x:context>
          <record>
            <leader>#####nam#a22######c#4500</leader>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="a">barrierefrei aufbereitet</subfield>
            </datafield>
            <datafield tag="MOD" ind1=" " ind2=" ">
              <subfield code="I">AT-UBW</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="SFi und SFu hinzugefügt" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">barrierefrei aufbereitet</subfield>
            <subfield code="i">AT-UBW</subfield>
            <subfield code="u">https://bibliothek.univie.ac.at/literaturservice.html</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="9700#$$Abarrierefrei aufbereitet, $$i leer">
        <x:context>
          <record>
            <leader>#####nam#a22######c#4500</leader>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="A">barrierefrei aufbereitet</subfield>
              <subfield code="i"></subfield>
            </datafield>
            <datafield tag="MOD" ind1=" " ind2=" ">
              <subfield code="I">AT-UBW</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="SFi SFu hinzugefügt" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">barrierefrei aufbereitet</subfield>
            <subfield code="i">AT-UBW</subfield>
            <subfield code="u">https://bibliothek.univie.ac.at/literaturservice.html</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="bereits vollständig befüllt">
        <x:context>
          <record>
            <leader>#####nam#a22######c#4500</leader>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="a">barrierefrei aufbereitet</subfield>
              <subfield code="i">AT-UBW</subfield>
            </datafield>
            <datafield tag="MOD" ind1=" " ind2=" ">
              <subfield code="I">AT-UBW</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="keine Änderung" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">barrierefrei aufbereitet</subfield>
            <subfield code="i">AT-UBW</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="bereits vollständig befülltes Feld vorhanden, zweites ohne SFi hinzugefügt">
        <x:context>
          <record>
            <leader>#####nam#a22######c#4500</leader>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="a">barrierefrei aufbereitet</subfield>
              <subfield code="i">AT-UBG</subfield>
            </datafield>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="A">barrierefrei aufbereitet</subfield>
            </datafield>
            <datafield tag="MOD" ind1=" " ind2=" ">
              <subfield code="I">AT-UBW</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="vollständiges Feld unverändert, SFi und SFu beim zweiten Feld hinzugefügt" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">barrierefrei aufbereitet</subfield>
            <subfield code="i">AT-UBG</subfield>
          </datafield>
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">barrierefrei aufbereitet</subfield>
            <subfield code="i">AT-UBW</subfield>
            <subfield code="u">https://bibliothek.univie.ac.at/literaturservice.html</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
    </x:scenario>
    <x:scenario label="Indikatoren bei 'Dublette zu' setzen">
      <x:context>
        <datafield tag="970" ind1=" " ind2=" ">
          <subfield code="A">Dublette zu AC12345678</subfield>
        </datafield>
        <datafield tag="970" ind1=" " ind2=" ">
          <subfield code="a">Dies scheint eine Dublette zu einem anderen Buch zu sein</subfield>
        </datafield>
      </x:context>
      <x:expect label="Indikatoren auf '0#' gesetzt">
        <datafield tag="970" ind1="0" ind2=" ">
          <subfield code="a">Dublette zu AC12345678</subfield>
        </datafield>
        <datafield tag="970" ind1="0" ind2=" ">
          <subfield code="a">Dies scheint eine Dublette zu einem anderen Buch zu sein</subfield>
        </datafield>
      </x:expect>
    </x:scenario>
    <x:scenario label="Indikatoren bei Fachgruppen berichtigen">
      <x:scenario label="Indikatoren stimmen">
        <x:context>
          <datafield tag="970" ind1="1" ind2=" ">
            <subfield code="c">54</subfield>
          </datafield>
        </x:context>
        <x:expect label="keine Änderung">
          <datafield tag="970" ind1="1" ind2=" ">
            <subfield code="c">54</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="Indikator falsch, nur SFc">
        <x:context>
          <datafield tag="970" ind1=" " ind2=" ">
            <subfield code="c">54</subfield>
          </datafield>
        </x:context>
        <x:expect label="Indikator berichtigt">
          <datafield tag="970" ind1="1" ind2=" ">
            <subfield code="c">54</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="Indikator falsch, mehrere Subfelder">
        <x:context>
          <datafield tag="970" ind1="4" ind2=" ">
            <subfield code="b">DE-627</subfield>
            <subfield code="c">54</subfield>
            <subfield code="d">Subfield d</subfield>
          </datafield>
        </x:context>
        <x:expect label="ein Feld 970 für jedes Subfeld">
          <datafield tag="970" ind1="4" ind2=" ">
            <subfield code="b">DE-627</subfield>
            <subfield code="d">Subfield d</subfield>
          </datafield>
          <datafield tag="970" ind1="1" ind2=" ">
            <subfield code="c">54</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="970##$$c mit Wert der nicht ins Schema passt">
        <x:context>
          <datafield tag="970" ind1=" " ind2=" ">
            <subfield code="c">99</subfield>
          </datafield>
        </x:context>
        <x:expect label="keine Änderung">
          <datafield tag="970" ind1=" " ind2=" ">
            <subfield code="c">99</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
    </x:scenario>
    <x:scenario label="9702#$$a entfernen">
      <x:scenario label="beliebiger Wert">
        <x:context>
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="a">AT-UBG</subfield>
          </datafield>
        </x:context>
        <x:expect label="Subfeld a gelöscht">
          <datafield tag="970" ind1="2" ind2=" ">
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="Wert, der in ein anderes Feld sollte">
        <x:context>
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="a">NAK</subfield>
          </datafield>
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="a">HS-DISS</subfield>
          </datafield>
        </x:context>
        <x:expect label="behalten">
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="a">NAK</subfield>
          </datafield>
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="a">HS-DISS</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="mehrere Subfelder">
        <x:context>
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="a">UBI</subfield>
            <subfield code="d">HS-MASTER</subfield>
          </datafield>
        </x:context>
        <x:expect label="nur Subfeld a gelöscht">
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="d">HS-MASTER</subfield>
          </datafield>
        </x:expect>
      </x:scenario>

    </x:scenario>

    <x:scenario label="LKR-Markierung in 9707#">
      <x:context>
        <record>
          <leader>#####nam#a22######c#4500</leader>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">LKR/ITM-UBG</subfield>
          </datafield>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">LKR/ITM</subfield>
          </datafield>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">LKR</subfield>
          </datafield>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">ITM</subfield>
          </datafield>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">lkr/itm</subfield>
          </datafield>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">lkr</subfield>
          </datafield>
          <datafield tag="970" ind1="7" ind2=" ">
            <subfield code="a">itm</subfield>
          </datafield>
          <datafield tag="MOD" ind1=" " ind2=" ">
            <subfield code="I">AT-OBV</subfield>
          </datafield>
        </record>
      </x:context>
      <x:expect label="ISIL-hinzugefügt" test="/record/datafield[@tag='970']">
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-UBG</subfield>
        </datafield>
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-OBV</subfield>
        </datafield>
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-OBV</subfield>
        </datafield>
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-OBV</subfield>
        </datafield>
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-OBV</subfield>
        </datafield>
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-OBV</subfield>
        </datafield>
        <datafield tag="970" ind1="7" ind2=" ">
          <subfield code="a">LKR/ITM-OBV</subfield>
        </datafield>
      </x:expect>
    </x:scenario>
    <x:scenario label="Markierung NAK-Bestand">
      <x:scenario label="kein SFv">
        <x:context>
          <record>
            <datafield tag="090" ind1=" " ind2=" ">
              <subfield code="v">1</subfield>
            </datafield>
            <datafield tag="970" ind1="2" ind2=" ">
              <subfield code="a">AT-OeNB</subfield>
              <subfield code="d">NAK</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="SFv hinzugefügt" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="2" ind2=" ">
            <subfield code="d">NAK</subfield>
            <subfield code="v">NAK-Bestand</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
    </x:scenario>

    <x:scenario label="KI-Assistent">
      <x:scenario label="588, aber keine 9700#$$aAI-Assistant">
        <x:context>
          <record>
            <controlfield tag="009">AC12345678</controlfield>
            <datafield tag="588" ind1=" " ind2=" ">
              <subfield code="a">Part of the metadata in this record was created with the help of AI Metadata Assistant</subfield>
            </datafield>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="a">Digitaler Assistent</subfield>
            </datafield>
            <datafield tag="MOD" ind1=" " ind2=" ">
              <subfield code="I">AT-OBV</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="97008 mit allen nötigen Daten eingefügt" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">AI-Assistant</subfield>
            <subfield code="x">enhanced</subfield>
            <subfield code="y">2233-03-22T12:12:12</subfield>
            <subfield code="i">AT-OBV</subfield>
          </datafield>
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">Digitaler Assistent</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="9700#$$aAI-Assistant vorhanden, ISIL fehlt">
        <x:context>
          <record>
            <datafield tag="970" ind1="0" ind2=" ">
              <subfield code="a">AI-Assistant</subfield>
              <subfield code="y">2233-03-22T12:12:12</subfield>
              <subfield code="r">FE-OK</subfield>
            </datafield>
            <datafield tag="MOD" ind1=" " ind2=" ">
              <subfield code="I">AT-OBV</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="SFi mit ISIL eingefügt" test="/record/datafield[@tag='970']">
          <datafield tag="970" ind1="0" ind2=" ">
            <subfield code="a">AI-Assistant</subfield>
            <subfield code="y">2233-03-22T12:12:12</subfield>
            <subfield code="i">AT-OBV</subfield>
            <subfield code="r">FE-OK | AT-OBV | 2233-03-22T12:12:12</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
    </x:scenario>
    <x:scenario label="ZDB-Redaktionsfeld">
      <x:scenario label="970 SfZ">
        <x:context>
          <datafield tag="970" ind1=" " ind2=" ">
            <subfield code="Z">Krawuzikapuzi</subfield>
          </datafield>
        </x:context>
        <x:expect label="auf SFa geändert">
          <datafield tag="970" ind1=" " ind2=" ">
            <subfield code="a">Krawuzikapuzi</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="ZDB-NEU-Eintrag in 970, keine passende 035">
        <x:context>
          <record>
            <controlfield tag="001">990000000000000003331</controlfield>
            <controlfield tag="009">AC12345678</controlfield>
            <datafield tag="016" ind1="7" ind2=" ">
              <subfield code="a">ZDB-123456-7</subfield>
              <subfield code="2">DE-600</subfield>
            </datafield>
            <datafield tag="035" ind1=" " ind2=" ">
              <subfield code="a">(AT-OBV)AC12345678</subfield>
            </datafield>
            <datafield tag="035" ind1=" " ind2=" ">
              <subfield code="a">(DE-599)OBVAC12345678</subfield>
            </datafield>
            <datafield tag="035" ind1=" " ind2=" ">
              <subfield code="a">(DE-600)ZDB-123456-7</subfield>
            </datafield>
            <datafield tag="970" ind1=" " ind2=" ">
              <subfield code="a">ZDB-NEU-2026-07-10</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="indikatoren angepasst"
          test="/record/datafield[not(@tag='040')]">
          <datafield tag="016" ind1="7" ind2=" ">
            <subfield code="a">ZDB-123456-7</subfield>
            <subfield code="2">DE-600</subfield>
          </datafield>
          <datafield tag="035" ind1=" " ind2=" ">
            <subfield code="a">(AT-OBV)AC12345678</subfield>
          </datafield>
          <datafield tag="035" ind1=" " ind2=" ">
            <subfield code="a">(DE-599)OBVAC12345678</subfield>
          </datafield>
          <datafield tag="035" ind1=" " ind2=" ">
            <subfield code="a">(DE-600)ZDB-123456-7</subfield>
          </datafield>
          <datafield tag="970" ind1="3" ind2=" ">
            <subfield code="a">ZDB-NEU-2026-07-10</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
      <x:scenario label="ZDB-NEU-Eintrag in 970, valide ZDB-Nummer in 035">
        <x:context>
          <record>
            <controlfield tag="001">990000000000000003331</controlfield>
            <controlfield tag="009">AC12345678</controlfield>
            <datafield tag="016" ind1="7" ind2=" ">
              <subfield code="a">ZDB-123456-7</subfield>
              <subfield code="2">DE-600</subfield>
            </datafield>
            <datafield tag="035" ind1=" " ind2=" ">
              <subfield code="a">(AT-OBV)AC12345678</subfield>
            </datafield>
            <datafield tag="035" ind1=" " ind2=" ">
              <subfield code="a">(DE-599)OBVAC12345678</subfield>
            </datafield>
            <datafield tag="035" ind1=" " ind2=" ">
              <subfield code="a">(DE-600)123456-7</subfield>
            </datafield>
            <datafield tag="970" ind1="3" ind2=" ">
              <subfield code="a">ZDB-NEU-2026-07-10</subfield>
            </datafield>
          </record>
        </x:context>
        <x:expect label="9703# gelöscht"
          test="/record/datafield[not(@tag='040')]">
          <datafield tag="016" ind1="7" ind2=" ">
            <subfield code="a">123456-7</subfield>
            <subfield code="2">DE-600</subfield>
          </datafield>
          <datafield tag="035" ind1=" " ind2=" ">
            <subfield code="a">(AT-OBV)AC12345678</subfield>
          </datafield>
          <datafield tag="035" ind1=" " ind2=" ">
            <subfield code="a">(DE-599)OBVAC12345678</subfield>
          </datafield>
          <datafield tag="035" ind1=" " ind2=" ">
            <subfield code="a">(DE-600)123456-7</subfield>
          </datafield>
        </x:expect>
      </x:scenario>
    </x:scenario>
    <x:scenario label="974">
      <x:scenario label="9740u, 9740s, 9740p">
        <x:context>
          <datafield tag="974" ind1="0" ind2="u">
            <subfield code="V">903</subfield>
            <subfield code="a">21</subfield>
          </datafield>
          <datafield tag="974" ind1="0" ind2="s">
            <subfield code="F">050</subfield>
            <subfield code="A">a|a|||||||||||</subfield>
          </datafield>
          <datafield tag="974" ind1="0" ind2="p">
            <subfield code="V">500##</subfield>
            <subfield code="a">Geparktes Feld</subfield>
          </datafield>
        </x:context>
        <x:expect label="9740u und 9740s gelöscht">
          <datafield tag="974" ind1="0" ind2="p">
            <subfield code="V">500##</subfield>
            <subfield code="a">Geparktes Feld</subfield>
          </datafield>
        </x:expect>
      </x:scenario>

    </x:scenario>
  </x:scenario>
</x:description>
